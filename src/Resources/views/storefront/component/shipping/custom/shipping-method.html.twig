{% sw_extends '@Storefront/storefront/component/shipping/shipping-method.html.twig' %}

{% block component_shipping_method_label %}
    {{ parent() }}

    {% if config('KommandhubClickAndPickSW.config.enablePickupLocationSelection') %}
    {% block component_shipping_method_label_kommandhub_self_pickup %}
        {% if shipping.technicalName is same as('kommandhub_self_pickup')%}
            {% block component_shipping_method_label_kommandhub_self_pickup_inner %}
            {% set salesChannelPickupLocationOptions = {
                url: path("frontend.kommandhub.sales-channel.pickup-locations.index", { salesChannelId: context.salesChannel.id }),
                selectedPickupLocationId: context.extensions.pickupLocation.id
            } %}

            {% block component_shipping_method_label_kommandhub_self_pickup_field_container %}
            <div id="pickup-location-location-field-id-container"
                 class="mt-3"
                 data-sales-channel-pickup-location="true"
                 data-sales-channel-pickup-location-options="{{ salesChannelPickupLocationOptions|json_encode }}">
                {% block component_shipping_method_label_kommandhub_self_pickup_field_label %}
                    <label for="pickup-location-location-field-id">Select Pickup Location</label>
                {% endblock %}
                {% block component_shipping_method_label_kommandhub_self_pickup_location_field %}
                    <select id="pickup-location-location-field-id"
                            name="pickupLocationId"
                            class="form-control shipping-method-input">
                    </select>
                {% endblock %}

                {% if context.extensions.pickupLocation.id is not null %}
                {% set salesChannelPickupLocationInfoOptions = {
                    url: path("frontend.kommandhub.sales-channel.pickup-locations.show", { salesChannelId: context.salesChannel.id, locationId: context.extensions.pickupLocation.id }),
                }%}

                {% block component_shipping_method_label_kommandhub_self_pickup_location_field_info %}
                    <div data-sales-channel-pickup-location-info="true"
                         data-sales-channel-pickup-location-info-options="{{ salesChannelPickupLocationInfoOptions|json_encode }}"></div>
                {% endblock %}
                {% endif %}
            </div>
            {% endblock %}
            {% endblock %}
        {% endif %}
    {% endblock %}
    {% endif %}
{% endblock %}
