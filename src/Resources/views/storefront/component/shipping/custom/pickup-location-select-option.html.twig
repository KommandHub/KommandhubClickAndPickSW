{% block pickup_location_select_option_container %}
    <option value="" data-pickup-location-location-field-id-option>Please select</option>
    {% for location in locations %}
        <option class="pickup-location-location-field-id-option" value="{{ location.id }}"
                {% if location.id is same as(context.extensions.pickupLocation.id) %}selected{% endif %}>
            {{ location.name }}{% if config('KommandhubClickAndPickSW.config.showStreetNameInPickupLocationSelectionField') %} - {{ location.street }}{% endif %}, {{ location.city }}
            {% if location.openingHours || location.closingHours %}
             | <span class="pickup-location-location-field-id-option__open">Open: {{ location.openingHours }} - {{ location.closingHours }}</span>
            {% endif %}
        </option>
    {% endfor %}
{% endblock %}