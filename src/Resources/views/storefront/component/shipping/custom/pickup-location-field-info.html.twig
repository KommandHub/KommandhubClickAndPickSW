{% block pickup_location_field_info %}
    {% if location is not null %}
    {% block pickup_location_field_info_style %}
        <style>
            .pickup-location-card {
                background: #fff;
                font-family: Arial, sans-serif;
                line-height: 1.4;  /* tighter spacing */
            }

            .pickup-section {
                margin-bottom: 6px; /* reduced spacing */
            }

            .pickup-section p {
                margin: 2px 0;      /* tighter paragraph spacing */
            }
        </style>
    {% endblock %}

    {% block pickup_location_field_info_wrapper %}
        <div class="pickup-location-location-field-id-info-inner mt-3">
            {% block pickup_location_field_info_card %}
                <div class="pickup-location-card">
                    {% block pickup_location_field_info_name %}
                        <strong>{{ "general.kommandhub-click-and-pick.locationInfoFields.storeName" | trans }}:</strong> {{ location.name }}
                    {% endblock %}

                    {% block pickup_location_field_info_address_section %}
                        <div class="pickup-section">
                            <p class="pickup-address">
                                <strong>{{ "general.kommandhub-click-and-pick.locationInfoFields.address" | trans }}:</strong>
                                {{ location.street }}, {% if location.postalCode %}{{ location.postalCode }} {% endif %}{{ location.city }}
                            </p>
                        </div>
                    {% endblock %}

                    {% block pickup_location_field_info_schedule_section %}
                        <div class="pickup-section">
                            {% if location.openDays is not empty %}
                            <p><strong>{{ "general.kommandhub-click-and-pick.locationInfoFields.openDays" | trans }}:</strong> {{ format_calendar_days(location.openDays) }}</p>
                            {% endif %}
                            {% if location.openingHours is not null and location.closingHours is not null %}
                            <p><strong>{{ "general.kommandhub-click-and-pick.locationInfoFields.openHours" | trans }}:</strong> {{ location.openingHours }} - {{ location.closingHours }}</p>
                            {% endif %}
                        </div>
                    {% endblock %}

                    {% block pickup_location_field_info_contact_section %}
                        {% if config('KommandhubClickAndPickSW.config.showContactDetailInPickupLocationInfo') %}
                            <div class="pickup-section">
                                {% if location.phoneNumber %}
                                    <p><strong>{{ "general.kommandhub-click-and-pick.locationInfoFields.phone" | trans }}:</strong> {{ location.phoneNumber }}</p>
                                {% endif %}
                                {% if location.email %}
                                    <p><strong>{{ "general.kommandhub-click-and-pick.locationInfoFields.email" | trans }}:</strong> {{ location.email }}</p>
                                {% endif %}
                            </div>
                        {% endif %}
                    {% endblock %}
                </div>
            {% endblock %}
        </div>
    {% endblock %}
    {% endif %}
{% endblock %}
