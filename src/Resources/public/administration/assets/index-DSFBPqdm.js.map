{% block kommandhub_pickup_location_base_form %}
    <div class="kommandhub-pickup-location-base-form">
        <sw-container
            columns="repeat(auto-fit, minmax(250px, 1fr))"
            gap="0px 32px"
        >
            {% block kommandhub_pickup_location_base_form_first_name_field %}
                <mt-text-field
                    v-model="pickupLocation.name"
                    validation="required"
                    required
                    name="sw-field--pickupLocation-name"
                    :label="$tc('kommandhub-pickup-location.baseForm.labelName')"
                    :placeholder="$tc('kommandhub-pickup-location.baseForm.placeholderName')"
                    :error="pickupLocationNameError"
                />
            {% endblock %}

            {% block kommandhub_pickup_location_base_form_street_field %}
                <mt-text-field
                    v-model="pickupLocation.street"
                    name="sw-field--pickupLocation-street"
                    validation="required"
                    required
                    :label="$tc('kommandhub-pickup-location.baseForm.labelStreet')"
                    :placeholder="$tc('kommandhub-pickup-location.baseForm.placeholderStreet')"
                    :error="pickupLocationStreetError"
                />
            {% endblock %}

            {% block kommandhub_pickup_location_base_form_phone_number_field %}
                <mt-text-field
                    v-model="pickupLocation.phoneNumber"
                    name="sw-field--pickupLocation-phoneNumber"
                    :label="$tc('kommandhub-pickup-location.baseForm.labelPhoneNumber')"
                    :placeholder="$tc('kommandhub-pickup-location.baseForm.placeholderPhoneNumber')"
                    :error="pickupLocationPhoneNumberError"
                />
            {% endblock %}

            {% block kommandhub_pickup_location_base_form_email_field %}
                <mt-email-field
                    v-model="pickupLocation.email"
                    name="sw-field--pickupLocation-email"
                    validation="required"
                    required
                    :label="$tc('kommandhub-pickup-location.baseForm.labelEmail')"
                    :placeholder="$tc('kommandhub-pickup-location.baseForm.placeholderEmail')"
                    :error="pickupLocationEmailError"
                />
            {% endblock %}

            {% block kommandhub_pickup_location_base_form_additional_address_line_1_field %}
                <mt-text-field
                    v-model="pickupLocation.additionalAddressLine1"
                    name="sw-field--pickupLocation-additionalAddressLine1"
                    :label="$tc('kommandhub-pickup-location.baseForm.labelAdditionalAddressLine1')"
                    :placeholder="$tc('kommandhub-pickup-location.baseForm.placeholderAdditionalAddressLine1')"
                    :error="pickupLocationAdditionalAddressLine1Error"
                />
            {% endblock %}

            {% block kommandhub_pickup_location_base_form_additional_address_line_2_field %}
                <mt-text-field
                    v-model="pickupLocation.additionalAddressLine2"
                    name="sw-field--pickupLocation-additionalAddressLine2"
                    :label="$tc('kommandhub-pickup-location.baseForm.labelAdditionalAddressLine2')"
                    :placeholder="$tc('kommandhub-pickup-location.baseForm.placeholderAdditionalAddressLine2')"
                    :error="pickupLocationAdditionalAddressLine2Error"
                />
            {% endblock %}

            {% block kommandhub_pickup_location_base_form_city_field %}
                <mt-text-field
                    v-model="pickupLocation.city"
                    name="sw-field--pickupLocation-city"
                    validation="required"
                    required
                    :label="$tc('kommandhub-pickup-location.baseForm.labelCity')"
                    :placeholder="$tc('kommandhub-pickup-location.baseForm.placeholderCity')"
                    :error="pickupLocationCityError"
                />
            {% endblock %}

            {% block kommandhub_pickup_location_base_form_postal_code_field %}
                <mt-text-field
                    v-model="pickupLocation.postalCode"
                    name="sw-field--pickupLocation-postalCode"
                    validation="required"
                    required
                    :label="$tc('kommandhub-pickup-location.baseForm.labelPostalCode')"
                    :placeholder="$tc('kommandhub-pickup-location.baseForm.placeholderPostalCode')"
                    :error="pickupLocationPostalCodeError"
                />
            {% endblock %}
        </sw-container>

        <sw-container>
            {% block kommandhub_pickup_location_base_form_pickupLocation_sales_channel_field %}
                <sw-entity-multi-select
                    class="kommandhub-pickup-location-base-form__sales-channel-select"
                    entity="sales_channel"
                    :label="$tc('kommandhub-pickup-location.baseForm.labelSalesChannel')"
                    :placeholder="$tc('kommandhub-pickup-location.baseForm.placeholderSalesChannel')"
                    :entity-collection="pickupLocation.salesChannels"
                    :error="pickupLocationSalesChannelsError"
                    required
                    show-clearable-button
                    @update:entity-collection="onSalesChannelChange"
                />
            {% endblock %}

        </sw-container>


        <sw-container
            columns="repeat(auto-fit, minmax(250px, 1fr))"
            gap="0px 32px"
        >
            {% block kommandhub_pickup_location_base_form_pickupLocation_latitude_field %}
                <mt-text-field
                    v-model="pickupLocation.latitude"
                    name="sw-field--pickupLocation-latitude"
                    :label="$tc('kommandhub-pickup-location.baseForm.labelLatitude')"
                    :placeholder="$tc('kommandhub-pickup-location.baseForm.placeholderLatitude')"
                    :error="pickupLocationLatitudeError"
                />
            {% endblock %}

            {% block kommandhub_pickup_location_base_form_pickupLocation_longitude_field %}
                <mt-text-field
                    v-model="pickupLocation.longitude"
                    name="sw-field--pickupLocation-longitude"
                    :label="$tc('kommandhub-pickup-location.baseForm.labelLongitude')"
                    :placeholder="$tc('kommandhub-pickup-location.baseForm.placeholderLongitude')"
                    :error="pickupLocationLongitudeError"
                />
            {% endblock %}
        </sw-container>

        <sw-container
                columns="2fr 1fr"
                gap="0px 32px"
        >
            {% block kommandhub_pickup_location_base_form_pickupLocation_location_code_field %}
                <mt-text-field
                    v-model="pickupLocation.locationCode"
                    name="sw-field--pickupLocation-locationCode"
                    :label="$tc('kommandhub-pickup-location.baseForm.labelLocationCode')"
                    :placeholder="$tc('kommandhub-pickup-location.baseForm.placeholderLocationCode')"
                    :error="pickupLocationLocationCodeError"
                />
            {% endblock %}

            {% block kommandhub_pickup_location_base_form_pickupLocation_active_field %}
                <mt-switch
                    v-model="pickupLocation.active"
                    name="sw-field--pickupLocation-active"
                    :label="$tc('kommandhub-pickup-location.baseForm.labelActive')"
                    bordered
                />
            {% endblock %}
        </sw-container>
    </div>
{% endblock %}