{%  block kommandhub_pickup_location_create %}
    <sw-page class="kommandhub-pickup-location">

        {% block kommandhub_pickup_location_create_header %}
            <template #smart-bar-header>
                <h2>{{ $tc('kommandhub-pickup-location.general.title') }}</h2>
            </template>
        {% endblock %}

        {% block kommandhub_pickup_location_create_actions %}
            <template #smart-bar-actions>
                <sw-button-process
                        class="kommandhub-pickup-location__save-action"
                        :is-loading="isLoading"
                        :disabled="isLoading"
                        :process-success="isSaveSuccessful"
                        variant="primary"
                        @update:process-success="saveFinish"
                        @click.prevent="onSave"
                >
                    {{ $tc('kommandhub-pickup-location.detail.buttonSave') }}
                </sw-button-process>
            </template>
        {% endblock %}

        {% block kommandhub_pickup_location_create_content %}
            <template #content>
                <sw-card-view>
                    {% block kommandhub_pickup_location_create_base_form %}
                        <mt-card
                                :title="cardLabel"
                                position-identifier="kommandhub-pickup-location-base-form"
                        >
                            <kommandhub-pickup-location-base-form
                                    v-if="pickupLocation"
                                    :is-loading="isLoading"
                                    :pickup-location="pickupLocation"
                                    @sales-channel-change="onChangeSalesChannel"
                            />
                        </mt-card>
                    {% endblock %}

                    {% block kommandhub_pickup_location_create_schedule %}
                        <mt-card
                                v-if="pickupLocation"
                                :title="$tc('kommandhub-pickup-location.schedule.cardTitle')"
                                position-identifier="kommandhub-pickup-location-schedule"
                        >
                            <kommandhub-pickup-location-schedule :pickup-location="pickupLocation" />
                        </mt-card>
                    {% endblock %}
                </sw-card-view>
            </template>
        {% endblock %}
    </sw-page>
{% endblock %}
